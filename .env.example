# ==============================================================================
# Cobalt Core — Variables de entorno
# ==============================================================================
# Copia este archivo a .env y ajusta los valores para tu entorno local.
#   cp .env.example .env
#
# NUNCA comitees .env al repositorio: contiene credenciales.
# El compose.dev.yml y compose.yml cargan este archivo automáticamente.
# ==============================================================================

# --- PostgreSQL ---
POSTGRES_DB=cobalt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# --- Servidor Cobalt ---
PORT=8080
MQTT_PORT=1883
MATTER_SERVER_URL=ws://host.docker.internal:5580/ws

# --- Pool de conexiones (pgxpool) ---
# Número máximo de conexiones abiertas simultáneamente
DB_MAX_CONNS=10
# Número mínimo de conexiones mantenidas en caliente
DB_MIN_CONNS=2

# --- Para tests locales (fuera de Docker) ---
# Usa localhost en lugar de 'postgres' (nombre del servicio Docker)
DATABASE_URL=postgres://postgres:password@localhost:5432/cobalt?sslmode=disable
